# Session-user read access to input devices via uaccess (no `input` group, no relogin).
# The `70-` prefix is load-bearing: past 71-seat/73-seat-late the tag lands but no ACL is ever applied.
# The uinput line needs the module loaded, else the node is static and matches nothing.
KERNEL=="event*", SUBSYSTEM=="input", TAG+="uaccess"
KERNEL=="uinput", TAG+="uaccess"
